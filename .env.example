# ========================================
# 🕎 KESHER API - קֶשֶׁר - CONFIGURAÇÃO
# ========================================

# Servidor
PORT=3001
NODE_ENV=development

# Firebase (copie do seu projeto Firebase)
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_ID=kesher-db

# Segurança da API
API_KEY=sua-chave-secreta-aqui
WEBHOOK_SECRET=seu-webhook-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Baileys Config
SESSION_COLLECTION=whatsapp-sessions
MAX_RECONNECT_ATTEMPTS=3
RECONNECT_INTERVAL_MS=30000

# URLs (para webhooks)
API_BASE_URL=http://localhost:3001

# ========================================
# 🟣 WHAPI (migração gradual — fase piloto)
# ========================================
# Fase 1: apenas números listados em WHAPI_PILOT_PHONES usam WHAPI.
# Todo o resto segue pelo Z-API (fluxo atual inalterado).
# Se WHAPI_PILOT_PHONES vazia/ausente → tudo vai por Z-API (failsafe).
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_TOKEN=
WHAPI_PILOT_PHONES=

# Exemplo de uso:
# WHAPI_TOKEN=SEU_TOKEN_WHAPI
# WHAPI_PILOT_PHONES=5547992567770
# Para adicionar mais números piloto no futuro:
# WHAPI_PILOT_PHONES=5547992567770,554799631813
